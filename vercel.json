{
  "crons": [
    {
      "path": "/api/update-data",
      "schedule": "*/30 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/static-data",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=300"
        }
      ]
    }
  ]
}